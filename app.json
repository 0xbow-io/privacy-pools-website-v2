{
  "expo": {
    "name": "privacy-pools",
    "slug": "wallet",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "privacypools",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.privacypools.v2",
      "associatedDomains": ["webcredentials:privacypools.com"]
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.privacypools.v2"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 128,
          "resizeMode": "contain",
          "backgroundColor": "#FAFAF9",
          "dark": {
            "image": "./assets/images/splash-icon-dark.png",
            "backgroundColor": "#0E0E0E"
          }
        }
      ],
      "expo-font",
      "expo-image",
      "expo-web-browser",
      [
        "expo-camera",
        {
          "cameraPermission": "The camera scans the QR that moves your account key from the web app.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "@0xbow/anon-rpc-rs-react-native",
      "./plugins/with-pod-deployment-target"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "445e37a9-564a-4020-a7b8-ea2aa8b70213"
      }
    },
    "owner": "privacypools"
  }
}
