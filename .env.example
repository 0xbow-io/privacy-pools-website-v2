# ASP API
EXPO_PUBLIC_ASP_URL=https://api-dev.0xbow.io
EXPO_PUBLIC_ASP_PUBLIC_KEY=0x031fa9e4035013764254198fabc6c1e61375a5ead70e788a8b9727cbdbe38b87e5

# RPC
# ALCHEMY_KEY derives both endpoints below when their explicit URLs are unset.
# ENS resolution always runs on mainnet, so the mainnet endpoint is kept
# separate to stop a Sepolia URL from backing the mainnet ENS client.
EXPO_PUBLIC_ALCHEMY_KEY=your_alchemy_api_key
# Sepolia endpoint: EXPO_PUBLIC_SEPOLIA_RPC_URL wins if set, otherwise the
# generic EXPO_PUBLIC_RPC_URL is used (kept for back-compat).
EXPO_PUBLIC_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/your_alchemy_api_key

# RPC endpoints are used in preference order, primary first:
#   1. Alchemy, whenever EXPO_PUBLIC_ALCHEMY_KEY is set
#   2. the *_RPC_FALLBACK_URL below - the explicit standby (QuickNode goes here)
#   3. the *_RPC_URL above - still honoured, but no longer primary
#   4. a public node, so the app works with nothing configured
# Consumers wrap the list in viem's fallback(), so a failing or rate-limiting
# primary rolls over instead of failing the call.
# To force one endpoint as primary (local node, fork), leave the Alchemy key unset.
EXPO_PUBLIC_RPC_FALLBACK_URL=
EXPO_PUBLIC_SEPOLIA_RPC_FALLBACK_URL=
EXPO_PUBLIC_MAINNET_RPC_FALLBACK_URL=

# EXPO_PUBLIC_SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/your_alchemy_api_key
# Mainnet endpoint, used for ENS name/address/avatar resolution.
EXPO_PUBLIC_MAINNET_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/your_alchemy_api_key

# Sepolia (11155111) protocol contracts. Override to re-point the client at a
# new deployment without code changes. When unset, config/env.ts falls back to
# the internal-testing "0xbow-v1" defaults. Entrypoint is NOT configured here —
# it is resolved at runtime from the ASP /entrypoints API.
EXPO_PUBLIC_SEPOLIA_POOL_ADDRESS=
EXPO_PUBLIC_SEPOLIA_KEYSTORE_ADDRESS=
EXPO_PUBLIC_SEPOLIA_FROM_BLOCK=
EXPO_PUBLIC_SEPOLIA_KEYSTORE_FROM_BLOCK=

# Test mode
TEST_MODE=true
EXPO_PUBLIC_TEST_MODE=true

# Cloudflare Turnstile (public site key — safe to commit)
EXPO_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAABx8SMv9TNWBg5N2

# Newsletter API (defaults to /api/newsletter-subscription on same origin)
EXPO_PUBLIC_NEWSLETTER_API_URL=/api/newsletter-subscription

# WalletConnect (Reown) project ID — get one at https://cloud.reown.com.
# Optional: on web, WalletConnect is disabled unless
# EXPO_PUBLIC_ENABLE_WALLETCONNECT_WEB=true is also set. When disabled,
# the wallet picker only offers browser-injected wallets (MetaMask,
# Rabby, …) and skips the WalletConnect tile.
EXPO_PUBLIC_WALLETCONNECT_PROJECT_ID=
EXPO_PUBLIC_ENABLE_WALLETCONNECT_WEB=false

# --- Smart-wallet onboarding (preview, OFF by default) ---
# Seedphrase-free embedded wallet: the app IS the wallet (a passkey-derived EOA
# signs locally, no external wallet) + a bottom-tab nav. Mobile-first: on native
# this is always on; on web it only activates when this flag is true. Leave unset
# (or false) and ppv2 behaves exactly as today (connect a regular wallet + passkey
# for keys, header nav). See plans/008-smart-wallet-onboarding.md.
EXPO_PUBLIC_ENABLE_SMART_WALLET=false

# --- Batch withdrawals (OFF by default) ---
# Full-balance withdrawals spanning >5 input notes: N proofs, one atomic
# relayBatch, automatic (no new UI actions) with a proof-progress bar. Leave
# false until (see config/env.ts enablement checklist): the batch-capable
# PrivacyPoolRelay is deployed (relayBatch + MAX_BATCH selectors), the relayer
# serves /v1/quote|relay/<type>/<chain>/batch, AND the relayer's committed
# batch-quote lifetime exceeds worst-case MAX_BATCH proving time (the 60s
# default is too short). As of 2026-07-14 none of these hold on Sepolia.
# Processor binding to the relay contract is already handled in-app.
EXPO_PUBLIC_BATCH_WITHDRAWALS=false

# --- Intent swaps (withdraw-and-swap via LiFi, OFF by default) ---
# Withdraw a private note and receive a different token via a proof-bound
# LiFi route. Leave false until (see config/intent-swaps.ts enablement
# checklist + issue patcito/0xbow-followups#1):
#   1. A RelaySwaps contract is deployed and set below — swap quotes route
#      from and proofs bind to it; leaving it unset keeps the feature dark
#      even with the flag on (fail closed). It is NOT the transfer signer
#      EOA and NOT the PrivacyPoolRelay withdrawal contract.
#   2. The deployed relayer serves POST /v1/quote/evm/<chainId>/swap and its
#      swap-route processor equals the address below (the staging relayer
#      404s on the route today — the UI fails closed with "swaps aren't
#      available yet"). The relayer's swap-quote TTL must also exceed
#      worst-case proving time + the app's 20s confirm safety window.
#   3. The pool runs on a LiFi-served chain. LiFi does NOT support Ethereum
#      Sepolia and its L2 Sepolia testnets return NO_QUOTE — real swaps are
#      mainnet/forked-mainnet only.
# DONE (no action needed): the vendored SDK is 71263ca8, which carries the
# swap money-safety guards (assertLifiBudget, committed-gross assertion,
# assertFeeCommitmentLive) — re-verify them in dist on every re-vendor.
# EVM-only: the swap action is hidden on Sui.
#
# DEFAULTS TO ON as of this branch: leaving the var unset enables it. The
# shielded-note flows (withdraw-and-swap, reshield) still stay dark without the
# processor address below, so the flag on its own only exposes swap-into-deposit
# ("Pay with").
# Setting it to false removes the Swap tab.
EXPO_PUBLIC_INTENT_SWAPS=true

# Points card on Portfolio, computed on the device from the account's own
# notes and the ASP's published epochs. Off unless set to true, and even then
# only while the Staging environment is selected (config/points.ts).
# EXPO_PUBLIC_POINTS_ENABLED=true

# Cross-chain reshield (flow 4): shielded asset on one chain -> shielded asset in
# another chain's pool, relayer-mediated over a LiFi bridge. Default ON in this
# private staging build; set to false to force it off. Only ever applies to
# Ethereum <-> Optimism (both ends must be LiFi networks with configured assets),
# and no UI drives it yet, so today it changes what is reachable in code only.
EXPO_PUBLIC_RESHIELD_CROSSCHAIN=true
# Deployed RelaySwaps contract for Sepolia (none exists yet — leave unset).
EXPO_PUBLIC_SEPOLIA_SWAP_PROCESSOR_ADDRESS=

# --- Legacy spend-out (post-contract-cutover) ---
# Safe to paste this whole block on BOTH the main and legacy Vercel
# projects. Legacy mode activates only when the build is being served
# from EXPO_PUBLIC_LEGACY_URL's hostname; on any other URL the address
# vars are inert and the build reads chains.ts normally. On the main
# URL, EXPO_PUBLIC_LEGACY_URL also drives the cutover banner that
# points users at the legacy build.
# EXPO_PUBLIC_LEGACY_URL=https://privacy-pools-website-v2-git-chore-legacy-mt-pin-0xbow.vercel.app
# EXPO_PUBLIC_LEGACY_MT_ID=305
# EXPO_PUBLIC_LEGACY_ENTRYPOINT=0x8445493038708311e55a526587d6ec4338377df0
# EXPO_PUBLIC_LEGACY_POOL=0xc131a029e8096fd427c2c2fd489b77c80b21574a
# EXPO_PUBLIC_LEGACY_KEYSTORE=0xbb52626b05aad8950c6e90397aef3c3cab7d9ed1

# --- Vercel serverless function secrets (set in Vercel dashboard, not here) ---
# TURNSTILE_SECRET_KEY=your_turnstile_secret_key
# MAILERLITE_API_KEY=your_mailerlite_api_key

# --- Sui testnet deployment (ASP-enabled redeploy, deployments/testnet.json) ---
# Which Sui network this build talks to: testnet (default) or mainnet. Only an
# explicit "mainnet" selects mainnet, and setting it currently makes config/sui.ts
# THROW at startup on purpose — mainnet has no deployed contracts and several
# paths still assume testnet. See the checklist at the top of config/sui.ts.
# EXPO_PUBLIC_SUI_NETWORK=testnet
#
# RPC override. Leave UNSET to derive it from EXPO_PUBLIC_ALCHEMY_KEY above
# (https://sui-<network>.g.alchemy.com/v2/<key>), which is what you want: Sui's
# public testnet fullnode is retired, and the public replacement node is pruned —
# it answers suix_queryEvents with "Could not find the referenced transaction
# events", which breaks note discovery and the LeavesInserted reconstruction that
# balances and withdrawals depend on.
#
# EXPO_PUBLIC_SUI_RPC_URL is the legacy, TESTNET-scoped override — it never feeds
# mainnet. Use the per-network variables to override a specific network; they take
# precedence over the legacy one.
# EXPO_PUBLIC_SUI_RPC_URL=
# EXPO_PUBLIC_SUI_TESTNET_RPC_URL=
# EXPO_PUBLIC_SUI_MAINNET_RPC_URL=
# Deployed object IDs. Defaults mirror config/sui-deployment.ts (package
# 0xaaef2b67, publish 5z91JC5i — tagged leaves, depths 22/18/18, live Sui ASP).
EXPO_PUBLIC_SUI_PACKAGE_ID=0xaaef2b67d15b8d73a83db671a9da840f8e0548daebf96d2d2ee2af91202b0fc6
EXPO_PUBLIC_SUI_POOL_ID=0x3bd5794fab542c89d37aca18694f16963261b05fec261fd09cc2c4464daeaef7
EXPO_PUBLIC_SUI_KEYSTORE_ID=0x36312c4f14dad7e5edea957045bd87d8a850f660f41ba3b8d6917079c346480a
EXPO_PUBLIC_SUI_ASP_REGISTRY_ID=0x41ede5df5083a3bb36502e17e078692dc53e8fba513c5df428e1278b89ea04d8
EXPO_PUBLIC_SUI_ENTRYPOINT_ID=0x8ccb80ef2f2af7ef2e11416687addb66b3d4afc19e06f70fd0d3ef51eb9c11ff
EXPO_PUBLIC_SUI_RELAY_CONFIG_ID=0xc84b1737a0fabeb168d3c989f561b0f6438d5f0f80993c557a3d1db0808a647e
# Global View Key (BabyJubJub pubkey). The UI prefers the live on-chain value
# (pool.gvk / gvk_enabled); this is only the compile-time fallback.
EXPO_PUBLIC_SUI_GVK_X=8000183593861526005546494415586001530851855863213787059736487848909126781386
EXPO_PUBLIC_SUI_GVK_Y=4719770751669487579175485260758459751413694420339086962996537886462047699885
# Sui relayer base URL. Empty => the withdraw modal uses the direct
# (user-submits-and-pays-gas) path instead of the relayed/gas-abstracted path.
EXPO_PUBLIC_SUI_RELAYER_URL=
# ASP approved-set source: the 0xbow ASP publishes pre-hashed association-set
# leaves for the Sui pool (chainId 102).
EXPO_PUBLIC_SUI_ASP_LABELS_URL=https://api-dev.0xbow.io/association-set/leaves?entrypoint=0x8ccb80ef2f2af7ef2e11416687addb66b3d4afc19e06f70fd0d3ef51eb9c11ff&chainId=102
# SUI circuit artifacts base (defaults to same-origin /artifacts/sui)
# EXPO_PUBLIC_SUI_ARTIFACT_BASE_URL=

# --- Stellar testnet deployment (v2-monorepo v2.0, 2026-09-30) ---
# Served in staging, debug-gated like Sui (?debug=1). Also available in the
# prod environment with EXPO_PUBLIC_STELLAR_ENABLED=true, to try it next to
# exactly what v2.privacypools.com serves. Runbook: docs/STELLAR_TESTNET.md.
# EXPO_PUBLIC_STELLAR_ENABLED=true
# Contract IDs default to config/stellar-deployment.ts.
# EXPO_PUBLIC_STELLAR_POOL_ID=CD7MO327ZMNRWQFKPCTOOZ45LDH3EOVCEM2BYRJSGXYVG4Q2BXJ4LNXY
# EXPO_PUBLIC_STELLAR_KEYSTORE_ID=CBCRN7ZYS5J3NCFL6CSCDZAFH7WZK3WPNXPNE3HFMRQ277AH6E5QDR3P
# EXPO_PUBLIC_STELLAR_ASP_REGISTRY_ID=CAU4IZTQYTXBUTCJIGVQOPSPEUTC6G4LXFCPYQRF4VLOCQDNY3ICAOZD
# EXPO_PUBLIC_STELLAR_RELAY_ID=CAL2LFF6F2GDXIEYA6VTH7BF2E2JZPSOUASBL6IGVLHVIK2RSESD42W6
# EXPO_PUBLIC_STELLAR_RPC_URL=https://soroban-testnet.stellar.org
# EXPO_PUBLIC_STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
# The ASP is the environment's (EXPO_PUBLIC_ASP_URL above). Testnet relayer for
# withdrawals (the v2 relayer, packages/relayer/relayer); unset, withdrawals refuse.
# EXPO_PUBLIC_STELLAR_RELAYER_URL=
# Relayed Stellar Send / pay / keep-claim (off unless exactly "true"). Needs a relayer with the Stellar transfer routes (v2-monorepo 860d5213).
# EXPO_PUBLIC_STELLAR_RELAYED_TRANSFERS=true
# Circuit artifacts: the EVM set under /artifacts, reused unchanged.
# EXPO_PUBLIC_STELLAR_ARTIFACT_BASE_URL=/artifacts
# LOCAL DEV ONLY: a testnet burner secret (S…) used instead of Freighter, for
# driving the flows in a browser without the extension. Refused on any
# non-localhost origin. Never put a key with real value here: EXPO_PUBLIC_*
# is inlined into the bundle. Put it in .env.local (gitignored), not here.
# EXPO_PUBLIC_STELLAR_DEV_SECRET=

# --- Staging EVM chains (INTERNAL deployments — real value) ---
# EXPO_PUBLIC_STAGING=true ADDS Ethereum mainnet (1), Citrea (4114) and
# Optimism (10) to the chain selector alongside the Sepolia default. Unset ⇒
# the normal Sepolia(+Sui) app, byte-for-byte. Addresses are pinned in
# config/staging-deployments.ts; only the operational knobs live here.
# EXPO_PUBLIC_STAGING=true
# Per-chain kill switch for OP without touching the other two.
# EXPO_PUBLIC_STAGING_OPTIMISM=false
#
# The relayer's SIGNER EOA per chain. This is the on-chain msg.sender — and so
# the proof `processor` — for the relayer's TRANSFER route: transfers are posted
# DIRECTLY from this EOA (relayer `simulateAndWriteRelayTransfer`), NOT through
# PrivacyPoolRelay like withdrawals are. Bind the relay contract instead and
# PoolVault reverts the whole transact with PoolVault_ProofContextMismatch,
# after the user has already paid ~30s of proving.
#
# The value is RELAYER-scoped (one key across all three chains today), but the
# relayer resolves it PER CHAIN (`SIGNER_PRIVATE_KEY_<chainId>`), so both a shared
# and a per-chain knob exist. Precedence: per-chain env > shared env > the
# STAGING_RELAYER_SIGNER default in config/staging-deployments.ts (verified
# 2026-08-20). Prefer the shared one; reach for a per-chain override only when the
# relayer genuinely diverges on one chain.
#
# Set these only to follow a key rotation. Recover the new address from any relayer
# fee commitment's `signedRelayerCommitment` (EIP-712 domain "Privacy Pools Relayer"
# v1, verifyingContract = that chain's relay) — full recipe in the config comment.
# EXPO_PUBLIC_STAGING_RELAYER_SIGNER=0x9e2f1B234953F46c6091636290E9035618EA3C07
# EXPO_PUBLIC_STAGING_MAINNET_RELAYER_SIGNER=
# EXPO_PUBLIC_STAGING_CITREA_RELAYER_SIGNER=
# EXPO_PUBLIC_STAGING_OPTIMISM_RELAYER_SIGNER=
#
# Per-chain relayer / RPC overrides. All three staging chains default to the
# one multi-chain testing relayer, which already carries their configs.
# EXPO_PUBLIC_STAGING_MAINNET_RELAYER_URL=
# EXPO_PUBLIC_STAGING_CITREA_RELAYER_URL=
# EXPO_PUBLIC_STAGING_OPTIMISM_RELAYER_URL=
# EXPO_PUBLIC_STAGING_MAINNET_RPC_URL=
# EXPO_PUBLIC_STAGING_CITREA_RPC_URL=
# EXPO_PUBLIC_STAGING_OPTIMISM_RPC_URL=

# --- Cold start (gasless keystore registration) ---
# Comma-separated `chainId:privacyPoolRelayAddress` pairs that ADD to (and
# override) VERIFIED_COLD_START_RELAYS in config/cold-start.ts. Lets ops light
# up a chain right after a redeploy without shipping code. Keyed on the relay
# address on purpose: an older relay on the same chain has no registerAndRelay,
# and offering a claim that always reverts is worse than not offering one.
# Malformed pairs are dropped (fail-closed), so a typo silently disables the
# chain rather than breaking the build — double-check what you paste.
# EXPO_PUBLIC_COLD_START_CLAIM_RELAYS=10:0x55DC6ADe57F3243c659cFe045F591C011924fECc
# Chains where a relayed registration also forwards native gas so the wallet can
# send setViewingKey. Replaces the default (1,56,4114); empty or `none` disables.
# EXPO_PUBLIC_REGISTRATION_TOP_UP_CHAINS=1,56,4114

# --- Environment: Prod vs Staging (config/app-environment.ts) ---
# One app serves two worlds. Prod = the prod ASP + prod relayer + the
# production pools (Ethereum, Citrea, BNB Chain). Staging = the dev ASP,
# Sepolia, the whitelisted staging pools above, and Sui. Default is prod.
# Testers switch in debug mode (?debug=1, header menu > Environment) or with a
# one-shot ?env=staging|prod; the choice is stored in localStorage and the
# page reloads. This var only sets the DEFAULT for a deployment.
# EXPO_PUBLIC_APP_ENV=prod
# Per-deposit USD cap the UI enforces. Prod defaults to 100 (launch limit, the ASP
# enforces the same); staging has none. A number overrides both; off/none/0 disables.
# EXPO_PUBLIC_MAX_DEPOSIT_USD=100
# Passkey unlock for smart-contract wallets (Safe, Ambire, Coinbase Smart Wallet, ...):
# on by default for every smart wallet. Set 0 here to hard-disable it for a build.
# EOAs always sign with the wallet first. The one exception: in the Coinbase app,
# when it fails both the v4 and the v3 request for an EOA delegated to Coinbase's
# 7702 proxy, that account falls back to the passkey.
# EXPO_PUBLIC_PASSKEY_PREVIEW=0
# Prod endpoints (code defaults; override only if ops moves them). The ASP must
# be https: the app is served over https and plain http is mixed content.
# EXPO_PUBLIC_PROD_ASP_URL=https://api-v2.0xbow.io
# EXPO_PUBLIC_PROD_RELAYER_URL=https://relayer-v2-prod-149184580131.us-east1.run.app
# The prod relayer's TRANSFER-route signer EOA, recovered from its fee
# commitments (see config/prod-deployments.ts). Shared knob + per-chain overrides.
# EXPO_PUBLIC_PROD_RELAYER_SIGNER=0x9e2f1B234953F46c6091636290E9035618EA3C07
# EXPO_PUBLIC_PROD_MAINNET_RELAYER_SIGNER=
# EXPO_PUBLIC_PROD_CITREA_RELAYER_SIGNER=
# EXPO_PUBLIC_PROD_BSC_RELAYER_SIGNER=
# Prod RPC overrides (Alchemy key first, public node last, as for staging).
# EXPO_PUBLIC_PROD_MAINNET_RPC_URL=
# EXPO_PUBLIC_PROD_CITREA_RPC_URL=
# EXPO_PUBLIC_PROD_BSC_RPC_URL=
# Prod ASP note-encryption key override (the SDK reads /public-key live when
# unset). The legacy EXPO_PUBLIC_ASP_PUBLIC_KEY applies to the STAGING (dev)
# ASP only: the two ASPs serve different keys.
# EXPO_PUBLIC_PROD_ASP_PUBLIC_KEY=
# Prod RelaySwaps (chains 1 and 56). EXPO_PUBLIC_MAINNET_/OPTIMISM_SWAP_PROCESSOR_ADDRESS
# belong to the staging deployments and never touch prod.
# EXPO_PUBLIC_PROD_RELAY_SWAPS_ADDRESS=0x5936aEfB2134550F3f526d65E984620582D270E7

# --- Error reporting: Sentry (web only, services/error-reports.ts) ---
# DEFAULTED IN CODE (config/env.ts), so a deploy does not have to set it and
# cannot silently lose reporting by forgetting to. A DSN is a public ingest
# key, not a secret: it ships in the client bundle by design. Set this only to
# point a fork at its own project, or to any non-URL value to turn reporting
# off.
#
# WHAT gets reported is not configurable. services/error-reports-event.ts builds
# every outgoing event from an allowlist and throws the original away: a fixed
# message, a few booleans, and nothing else. No error text, no stack, no URL,
# no breadcrumbs, no user, no traces, no replay.
# EXPO_PUBLIC_SENTRY_DSN=https://726f836298b9ca112faf0ef1df603d91@o4509437312958464.ingest.us.sentry.io/4512068713840640
# Optional build label, e.g. the deploy's git sha. Ours, never user data.
# EXPO_PUBLIC_SENTRY_RELEASE=

# --- Egress policy (services/egress-policy.ts) ---
# SHIPS IN REPORT MODE. A request the policy would refuse is still SENT; the
# refusal becomes a console warning and a Sentry event. Set this to `enforce`
# to fail closed, once real traffic has shown no refusals we did not expect.
# EXPO_PUBLIC_EGRESS_POLICY=enforce

# Public site domains (2026-10 switch: app on the apex, v1 on a subdomain).
# Public origin of this app: social/canonical tags at build time and the
# location.origin native builds use for share links and artifact fetches.
# EXPO_PUBLIC_APP_ORIGIN=https://privacypools.com
# The v1 site: header "v1" link and the whitepaper (<V1_URL>/whitepaper.pdf).
# EXPO_PUBLIC_V1_URL=https://v1.privacypools.com
# Share-link base (pay/, receive/, import-note/, verify/). Unset = current origin.
# EXPO_PUBLIC_PAY_URL_BASE=https://privacypools.com
