EXPO_PUBLIC_STAGING=true

# Stellar testnet shows with ?stellar=true (or ?debug=1). See docs/STELLAR_TESTNET.md.
# Its ASP is the environment's (EXPO_PUBLIC_ASP_URL, the dev asp-v2 in staging). Its
